# Backend Agent (the generator). The generated backend has its own backend/.env.example.
# --- LLM (not needed with --mock) -------------------------------------------------
LLM_PROVIDER=anthropic            # anthropic | openai_compatible | ollama | mock
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=                      # or ANTHROPIC_API_KEY; never commit a real key
# LLM_BASE_URL=http://localhost:11434/v1   # openai_compatible / ollama
LLM_TIMEOUT_SECONDS=120
# --- Pipeline ---------------------------------------------------------------------
MAX_CORRECTIONS=3                 # bounded autonomous correction rounds
# FRONTEND_AGENT_DIR=../Frontend-Agent/projects/task_manager   # read-only
# --- Integration tests: a DEDICATED database whose name contains "test" -------------
# TEST_DATABASE_URL=postgresql://backend_agent:backend_agent_dev_only@127.0.0.1:5433/backend_agent_test
# BACKEND_AGENT_TEST_DB_CONFIRM=<dbname>   # only to override the name/host safety check deliberately
LOG_LEVEL=INFO
