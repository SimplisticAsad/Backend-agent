{
  "architecture": {
    "api_framework": "fastapi",
    "api_versioning": "none",
    "api_versioning_note": "paths are served exactly as in api.json; the Frontend dev proxy strips its /api prefix",
    "authentication": true,
    "authorization": {
      "object_level": "engine rules (ownership, row scope, guards)",
      "role_checks": "dependency per operation"
    },
    "database": "postgresql",
    "database_driver": "psycopg 3 + psycopg_pool",
    "error_contract": "{error:{code,message,details}, message, errors, request_id}",
    "repository_pattern": true,
    "service_layer": true,
    "style": "clean architecture (api -> application -> domain/infrastructure)",
    "transactions": "explicit psycopg_pool transaction per operation; row locks (FOR UPDATE) before read-then-write",
    "validation": "pydantic v2"
  },
  "descriptions": {
    "DepartmentRepository": "Parameterised SQL access to table departments.",
    "DepartmentService": "Application service for service.department: 3 operation(s).",
    "EmployeeRepository": "Parameterised SQL access to table employees.",
    "EmployeeService": "Application service for service.employee: 4 operation(s).",
    "ProjectMemberRepository": "Parameterised SQL access to table project_members.",
    "ProjectMemberService": "Application service for service.project_member: 3 operation(s).",
    "ProjectRepository": "Parameterised SQL access to table projects.",
    "ProjectService": "Application service for service.project: 6 operation(s).",
    "TaskRepository": "Parameterised SQL access to table tasks.",
    "TaskService": "Application service for service.task: 7 operation(s).",
    "UserRepository": "Parameterised SQL access to table users.",
    "UserService": "Application service for service.user: 4 operation(s).",
    "backend_app.api": "HTTP routes, request/response schemas and dependencies; no business logic.",
    "backend_app.application": "Application services: one method per graph operation.",
    "backend_app.auth": "Authentication and role authorization.",
    "backend_app.domain": "Domain entities mirroring graph entities, and domain exceptions.",
    "backend_app.engine": "Spec-driven implementation of CRUD, state transitions and object-level rules.",
    "backend_app.infrastructure": "Repositories over the database contract."
  },
  "modules": [
    {
      "name": "backend_app.api",
      "purpose": "HTTP routes, request/response schemas and dependencies; no business logic."
    },
    {
      "name": "backend_app.application",
      "purpose": "Application services: one method per graph operation."
    },
    {
      "name": "backend_app.domain",
      "purpose": "Domain entities mirroring graph entities, and domain exceptions."
    },
    {
      "name": "backend_app.infrastructure",
      "purpose": "Repositories over the database contract."
    },
    {
      "name": "backend_app.engine",
      "purpose": "Spec-driven implementation of CRUD, state transitions and object-level rules."
    },
    {
      "name": "backend_app.auth",
      "purpose": "Authentication and role authorization."
    }
  ],
  "repositories": [
    {
      "entity": "entity.department",
      "name": "DepartmentRepository",
      "table": "departments"
    },
    {
      "entity": "entity.employee",
      "name": "EmployeeRepository",
      "table": "employees"
    },
    {
      "entity": "entity.project",
      "name": "ProjectRepository",
      "table": "projects"
    },
    {
      "entity": "entity.project_member",
      "name": "ProjectMemberRepository",
      "table": "project_members"
    },
    {
      "entity": "entity.task",
      "name": "TaskRepository",
      "table": "tasks"
    },
    {
      "entity": "entity.user",
      "name": "UserRepository",
      "table": "users"
    }
  ],
  "routes": [
