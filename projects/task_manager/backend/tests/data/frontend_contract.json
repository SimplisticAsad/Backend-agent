   ]
  }
 },
 "roles": {
  "role.employee": {
   "actor": "actor.person",
   "id": "role.employee",
   "key": "employee",
   "name": "Employee",
   "permissions": [
    "permission.dashboard.view",
    "permission.project.view",
    "permission.task.view",
    "permission.task.update_status"
   ]
  },
  "role.manager": {
   "actor": "actor.person",
   "id": "role.manager",
   "key": "manager",
   "name": "Manager",
   "permissions": [
    "permission.dashboard.view",
    "permission.project.view",
    "permission.project.create",
    "permission.project.delete",
    "permission.task.view",
    "permission.task.create",
    "permission.task.update_status",
    "permission.task.reopen"
   ]
  }
 },
 "state_machines": {
  "sm.task.status": {
   "entity": "entity.task",
   "field": "status",
   "id": "sm.task.status",
   "initial": "TODO",
   "states": [
    "TODO",
    "IN_PROGRESS",
    "COMPLETED"
   ],
   "transitions": [
    {
     "from": "TODO",
     "permission": "permission.task.update_status",
     "to": "IN_PROGRESS"
    },
    {
     "from": "IN_PROGRESS",
     "permission": "permission.task.update_status",
     "to": "COMPLETED"
    },
    {
     "from": "IN_PROGRESS",
     "permission": "permission.task.update_status",
     "to": "TODO"
    },
    {
     "from": "COMPLETED",
     "permission": "permission.task.reopen",
     "to": "IN_PROGRESS"
    }
   ]
  }
 }
