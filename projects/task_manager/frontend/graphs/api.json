        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true,
            "source": "path"
          }
        ]
      },
      "response": {
        "shape": "none"
      },
      "errors": [
        401,
        403,
        404,
        409,
        500
      ]
    },
    {
      "id": "api.task.list",
      "method": "GET",
      "path": "/tasks",
      "operation": "list",
      "auth": true,
      "permission": "permission.task.view",
      "request": {
        "fields": [
          {
            "name": "project_id",
            "type": "string",
            "required": false,
            "source": "query"
          }
        ]
      },
      "response": {
        "entity": "entity.task",
        "shape": "list"
      },
      "errors": [
        401,
        403,
        500
      ]
    },
    {
      "id": "api.task.get",
      "method": "GET",
      "path": "/tasks/{id}",
      "operation": "get",
      "auth": true,
      "permission": "permission.task.view",
      "request": {
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true,
            "source": "path"
          }
        ]
      },
      "response": {
        "entity": "entity.task",
        "shape": "single"
      },
      "errors": [
        401,
        403,
        404,
        500
      ]
    },
    {
      "id": "api.task.create",
      "method": "POST",
      "path": "/tasks",
      "operation": "create",
      "auth": true,
      "permission": "permission.task.create",
      "request": {
        "entity": "entity.task",
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true,
            "source": "form"
          },
          {
            "name": "description",
            "type": "text",
            "required": false,
            "source": "form"
          },
          {
            "name": "project_id",
            "type": "ref",
            "required": true,
            "source": "form"
          },
          {
            "name": "assignee_id",
            "type": "ref",
            "required": false,
            "source": "form"
          },
          {
            "name": "due_date",
            "type": "date",
            "required": false,
            "source": "form"
          }
        ]
      },
      "response": {
        "entity": "entity.task",
        "shape": "single"
      },
      "errors": [
        400,
        401,
        403,
        404,
        422,
        500
      ]
    },
    {
      "id": "api.task.update_status",
      "method": "PATCH",
      "path": "/tasks/{id}/status",
      "operation": "transition",
      "auth": true,
      "permission": "permission.task.update_status",
      "request": {
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true,
            "source": "path"
          },
          {
            "name": "status",
            "type": "enum",
            "required": true,
            "source": "input",
            "values": [
              "TODO",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          }
        ]
      },
      "response": {
        "entity": "entity.task",
        "shape": "single"
      },
      "errors": [
        400,
        401,
        403,
        404,
        409,
        422,
        500
      ]
    }
  ]
}
