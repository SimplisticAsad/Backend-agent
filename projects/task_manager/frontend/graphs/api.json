{
  "schema_version": "1.0",
  "graph": "api",
  "nodes": [
    {
      "id": "api.auth.login",
      "method": "POST",
      "path": "/auth/login",
      "operation": "login",
      "auth": false,
      "request": {
        "entity": "entity.credentials",
        "fields": [
          {
            "name": "email",
            "type": "email",
            "required": true,
            "source": "form"
          },
          {
            "name": "password",
            "type": "password",
            "required": true,
            "source": "form"
          }
        ]
      },
      "response": {
        "shape": "session"
      },
      "errors": [
        400,
        401,
        422,
        429,
        500
      ]
    },
    {
      "id": "api.user.list",
      "method": "GET",
      "path": "/users",
      "operation": "list",
      "auth": true,
      "permission": "permission.task.view",
      "response": {
        "entity": "entity.user",
        "shape": "list"
      },
      "errors": [
        401,
        403,
        500
      ]
    },
    {
      "id": "api.project.list",
      "method": "GET",
      "path": "/projects",
      "operation": "list",
      "auth": true,
      "permission": "permission.project.view",
      "response": {
        "entity": "entity.project",
        "shape": "list"
      },
      "errors": [
        401,
        403,
        500
      ]
    },
    {
      "id": "api.project.get",
      "method": "GET",
      "path": "/projects/{id}",
      "operation": "get",
      "auth": true,
      "permission": "permission.project.view",
      "request": {
        "fields": [
          {
            "name": "id",
            "type": "string",
            "required": true,
            "source": "path"
          }
        ]
      },
      "response": {
        "entity": "entity.project",
        "shape": "single"
      },
      "errors": [
        401,
        403,
        404,
        500
      ]
    },
    {
      "id": "api.project.create",
      "method": "POST",
      "path": "/projects",
      "operation": "create",
      "auth": true,
      "permission": "permission.project.create",
      "request": {
        "entity": "entity.project",
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true,
            "source": "form"
          },
          {
            "name": "description",
            "type": "text",
            "required": false,
            "source": "form"
          },
          {
            "name": "owner_id",
            "type": "ref",
            "required": true,
            "source": "session.user_id"
          }
        ]
      },
      "response": {
        "entity": "entity.project",
        "shape": "single"
      },
      "errors": [
        400,
        401,
        403,
        409,
        422,
        500
      ]
    },
    {
      "id": "api.project.delete",
      "method": "DELETE",
      "path": "/projects/{id}",
      "operation": "delete",
      "auth": true,
      "permission": "permission.project.delete",
