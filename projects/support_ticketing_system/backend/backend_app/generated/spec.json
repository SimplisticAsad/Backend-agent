  "state_machines": {
    "state_machine.ticket": {
      "entity": "entity.ticket",
      "field": "status",
      "id": "state_machine.ticket",
      "initial": "open",
      "states": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "transitions": [
        {
          "from": "open",
          "operation": "operation.ticket.change_status",
          "roles": [
            "role.agent",
            "role.manager"
          ],
          "to": "in_progress"
        },
        {
          "from": "in_progress",
          "operation": "operation.ticket.change_status",
          "roles": [
            "role.agent",
            "role.manager"
          ],
          "to": "resolved"
        },
        {
          "from": "resolved",
          "operation": "operation.ticket.change_status",
          "roles": [
            "role.agent",
            "role.manager"
          ],
          "to": "closed"
        },
        {
          "from": "resolved",
          "operation": "operation.ticket.change_status",
          "roles": [
            "role.agent",
            "role.manager"
          ],
          "to": "in_progress"
        }
      ]
    }
  }
