      "type": "row_scope"
    },
    {
      "entity": "entity.ticket_comment",
      "id": "rule.scope.implicit.ticket_comment.via_ticket_id",
      "operations": [
        "operation.ticket_comment.create",
        "operation.ticket_comment.list"
      ],
      "origin": "implicit_parent_scope",
      "roles": [
        "role.customer"
      ],
      "scope": {
        "fk": "ticket_id",
        "parent_entity": "entity.ticket",
        "parent_scope": {
          "field": "requester_id"
        }
      },
      "source": "heuristic:entity.ticket_comment belongs to entity.ticket which is private to its owner",
      "type": "row_scope"
    }
  ],
