        "scope": {
          "fk": "ticket_id",
          "parent_entity": "entity.ticket",
          "parent_scope": {
            "field": "requester_id"
          }
        },
        "source": "heuristic:entity.ticket_comment belongs to entity.ticket which is private to its owner",
        "type": "row_scope"
      }
    ],
