          "to": "paid"
        },
        {
          "from": "pending",
          "operation": null,
          "roles": [
            "role.customer"
          ],
          "to": "cancelled"
        },
        {
          "from": "paid",
          "operation": null,
          "roles": [],
          "to": "shipped"
        },
        {
          "from": "shipped",
          "operation": null,
          "roles": [],
          "to": "delivered"
