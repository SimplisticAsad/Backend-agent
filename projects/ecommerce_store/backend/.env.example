# Copy to .env (never commit real values)
APP_ENV=development                      # production/staging enforce JWT_SECRET and explicit CORS origins
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_SCHEMA=ecommerce_store   # schema created by the Database Agent
LOG_LEVEL=INFO
JWT_SECRET=                              # >= 32 random characters in production
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:5173       # the Frontend dev origin; list explicit origins, never '*'
DB_POOL_MIN=1
DB_POOL_MAX=10
MAX_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=20
LLM_PROVIDER=mock                        # only used by the Backend Agent itself, not by the generated service
